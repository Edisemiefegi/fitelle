rules_version = '2';

// Rules for the portfolio feature only. Merge into your existing rules
// (users, customers, orders...) rather than replacing them.
service cloud.firestore {
  match /databases/{database}/documents {

    // portfolios/{userId} — public to read (visitors load it by slug), owner-only to write.
    match /portfolios/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;

      // portfolios/{userId}/works/{workId} — visitors may only read published works.
      match /works/{workId} {
        allow read: if resource.data.status == 'published'
                    || (request.auth != null && request.auth.uid == userId);
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
